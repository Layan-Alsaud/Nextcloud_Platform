# Generate strong random values with:  openssl rand -base64 24

# PostgreSQL 
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme_use_openssl_rand

# Nextcloud admin (only applied on first install)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_use_openssl_rand

# Access 
# Must include the VM's public IP (domain name later).
NEXTCLOUD_TRUSTED_DOMAINS=YOUR.VM.PUBLIC.IP

# Redis ---
REDIS_PASSWORD=changeme_use_openssl_rand